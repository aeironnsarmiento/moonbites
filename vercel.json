{
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend"
    }
  },
  "rewrites": [
    {
      "source": "/recipes/:recipeImportId((?!create$)[^/]+)",
      "destination": "/_/backend/recipe-pages/:recipeImportId"
    }
  ]
}
